Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.04-py3

%post
    # OS tools 
    apt-get update && apt-get install -y \
        libxrender1 \
        libxext6 \
        libsm6 \
    && rm -rf /var/lib/apt/lists/*

    # Domain tools + Patched Hugging Face stack
    pip install --no-cache-dir \
        "rdkit>=2024.3.1" \
        "wandb>=0.17" \
        "optuna>=4.8" \
        "seaborn>=0.13" \
        "tqdm>=4.67" \
        "transformers>=4.48.0" \
        "accelerate>=1.3.0"

%environment
    # Locale settings
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # Hugging Face optimization
    export TOKENIZERS_PARALLELISM=false